# Convenience for setting groups of related Bazel flags
bazel_dep(
    name = "bazelrc-preset.bzl",
    version = "1.9.2",
    dev_dependency = True,
)

# Prebuilt binaries for buildifier and buildozer
bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.5.1.2",
    dev_dependency = True,
)

# Required to enable pre-built protoc binaries.
# Avoid C++ compilation of protoc, which fails
# with the Zig/lld toolchain.
#
# Pinned to 34.1: starting at 35.0, protobuf's MODULE.bazel stopped
# marking its crate_universe usage as dev_dependency, so any consumer
# using rules_rust >= 0.71.1 fails to resolve with "crates is in a
# non-root module but has no lockfile". Fix pending upstream.
# https://github.com/protocolbuffers/protobuf/issues/28224
bazel_dep(
    name = "protobuf",
    version = "34.1",
    dev_dependency = True,
)

# Hermetic C/C++ toolchain using Zig-bundled Clang.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

# C++ rules
# An auto-detecting toolchain that expects to find tools installed on the host machine.
bazel_dep(name = "rules_cc", version = "0.2.22")

# Build rules for interfacing with "foreign" (non-Bazel) build systems
# (CMake, configure-make, GNU Make, boost, ninja, Meson).
# bazel_dep(name = "rules_foreign_cc", version = "0.14.0")

# TODO: link zstd-sys against this instead of vendor-build.
# See also crate.annotation() in crate.MODULE.bazel.
#
# Currently broken: @zstd//:zstd is static-only, and rules_rust's linker
# args for static native libs assume a dylib is available too.
# This may be fixed by bazelbuild/rules_rust#3993, not yet merged.
# bazel_dep(name = "zstd", version = "1.5.7.bcr.1")

# Rust rules for Bazel
rules_rust_version = "0.74.0"

bazel_dep(name = "rules_rust", version = rules_rust_version)
bazel_dep(name = "rules_rust_pyo3", version = rules_rust_version)
# bazel_dep(name = "rules_rust_bindgen", version = rules_rust_version)
# bazel_dep(name = "rules_rust_mdbook", version = rules_rust_version)
# bazel_dep(name = "rules_rust_prost", version = rules_rust_version)
# bazel_dep(name = "rules_rust_protobuf", version = rules_rust_version)

# protobuf pulls in rules_go, rules_jvm_external, and rules_android
# transitively. Left to MVS they resolve to rules_go 0.51, rules_jvm_external
# 6.7, and rules_android 0.6.4, all of which reference the top-level CcInfo
# symbol that the current Bazel has removed, so loading them fails. These pins
# raise them to loadable versions.
#
# Nothing here uses rules_android directly. It still breaks CI because GitHub
# runners set ANDROID_HOME, which makes rules_android fetch @androidsdk and
# load its .bzl files during toolchain resolution.
bazel_dep(name = "rules_go", version = "0.63.0", dev_dependency = True)
bazel_dep(name = "rules_jvm_external", version = "6.10", dev_dependency = True)
bazel_dep(name = "rules_android", version = "0.7.1", dev_dependency = True)

# Python rules for Bazel
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "rules_uv", version = "0.89.2")

# Shell rules
bazel_dep(name = "rules_shell", version = "0.8.0")

# Constraint values for specifying platforms and toolchains
bazel_dep(name = "platforms", version = "1.1.0")

# Common functions and rules for Bazel
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# Libraries and rules for constructing rules and BUILD files
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# Rules for creating packages (zip, tar, deb, rpm, ...)
bazel_dep(name = "rules_pkg", version = "1.2.0")

