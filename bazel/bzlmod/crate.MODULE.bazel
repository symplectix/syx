crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
)

# Ad-hoc error type and derive macro for custom error enums.
crate.spec(
    package = "anyhow",
    version = "1",
)
crate.spec(
    package = "thiserror",
    version = "2",
)

# Async runtime and utilities.
crate.spec(
    features = ["full"],
    package = "tokio",
    version = "1.52",
)
crate.spec(
    package = "futures",
    version = "0.3",
)

# Structured, async-aware logging and instrumentation.
crate.spec(
    package = "tracing",
    version = "0.1",
)
crate.spec(
    features = ["env-filter"],
    package = "tracing-subscriber",
    version = "0.3",
)

# Reference-counted byte buffer (Bytes/BytesMut).
crate.spec(
    package = "bytes",
    version = "1",
)

# Read-only memory-mapped files, for zero-copy reads of segments that are
# already sealed (and so never written to again -- see syx/forgetter)
# into an `Arc`-shared, `Bytes::from_owner`-wrapped buffer.
crate.spec(
    package = "memmap2",
    version = "0.9",
)

# Lock-free ordered map: used by syx/forgetter to track pending segments
# without a lock shared between the committer and readers, and by
# syx/fabric to group staged digests per segment.
crate.spec(
    package = "crossbeam-skiplist",
    version = "0.1",
)

# Sharded concurrent hash map: syx/fabric uses this for the per-segment
# digest map inside its `KeyDir`, where writes concentrate on whichever
# one segment is currently active rather than spreading across keys, a
# pattern shared locking scales better for than a lock-free skip list.
crate.spec(
    package = "dashmap",
    version = "6",
)

