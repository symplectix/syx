# Shared token stream type between proc macros and the compiler.
crate.spec(
    package = "proc-macro2",
    version = "1",
)

# rust_proc_macro dependencies.
#
# hermetic_cc_toolchain's LLVM (20) and rustc's LLVM (22) are different
# versions. Under --config=release, rules_rust sets -Clinker-plugin-lto
# on rust_proc_macro dependencies, so rustc emits bitcode only, and the
# linker (lld from hermetic_cc_toolchain) has to read it directly to
# link a proc-macro against it. This works for some crates but not
# others depending on which LLVM IR features they emit;
# syn 3.0.5 hits an attribute the older lld doesn't know
# ("Unknown attribute kind (103)"). -Clinker-plugin-lto=off makes rustc
# embed native object code too, sidestepping the bitcode path entirely.
crate.annotation(
    crate = "proc-macro2",
    rustc_flags = ["-Clinker-plugin-lto=off"],
)
crate.annotation(
    crate = "syn",
    rustc_flags = ["-Clinker-plugin-lto=off"],
)
crate.annotation(
    crate = "quote",
    rustc_flags = ["-Clinker-plugin-lto=off"],
)
crate.annotation(
    crate = "unicode-ident",
    rustc_flags = ["-Clinker-plugin-lto=off"],
)

