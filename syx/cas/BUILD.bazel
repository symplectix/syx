load("//bazel:rust.bzl", "rust")

rust.library(
    name = "cas",
    srcs = [
        "src/chunking.rs",
        "src/hash.rs",
        "src/lib.rs",
        "src/storage.rs",
        "src/storage/codec.rs",
        "src/storage/packs.rs",
        "src/storage/stage.rs",
        "src/storage/tests.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:bitflags",
        "@crates//:bytes",
        "@crates//:fastcdc",
        "@crates//:futures",
        "@crates//:object_store",
        "@crates//:serde",
        "@crates//:serde_bytes",
        "@crates//:sha2",
        "@crates//:slatedb",
        "@crates//:tokio",
        "@crates//:zstd",
    ],
)

rust.test(
    name = "cas_test",
    size = "small",
    crate = ":cas",
    deps = [
        "//syx/testing",
        "@crates//:object_store",
        "@crates//:slatedb",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

rust.test(
    name = "cas_remote_object_store_test",
    size = "small",
    srcs = ["tests/remote_object_store.rs"],
    data = ["@minio_static//file"],
    # The bundled minio_static binary sometimes reports "Server not
    # initialized yet" on its first request right after startup.
    flaky = True,
    # The minio_static runfile is a static Linux/amd64 binary.
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":cas",
        "//syx/testing",
        "@crates//:aws-sdk-s3",
        "@crates//:object_store",
        "@crates//:slatedb",
        "@crates//:tokio",
    ],
)

rust.test(
    name = "cas_packing_storage_test",
    size = "small",
    srcs = ["tests/packing_storage.rs"],
    deps = [
        ":cas",
        "//syx/testing",
        "@crates//:futures",
        "@crates//:object_store",
        "@crates//:slatedb",
        "@crates//:tokio",
    ],
)

rust.test_suite(
    name = "cas_test_suite",
    size = "small",
    srcs = [
        "tests/digest_fidelity.rs",
        "tests/digest_is_deterministic.rs",
        "tests/digest_is_sensitive.rs",
    ],
    shared_srcs = ["tests/common/mod.rs"],
    deps = [
        ":cas",
        "//syx/cas_testing",
        "@crates//:cbor2",
        "@crates//:serde",
        "@crates//:serde_bytes",
        "@crates//:tokio",
    ],
)
